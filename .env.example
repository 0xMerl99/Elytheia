# Everything here is optional. With no .env at all the site runs against Solana mainnet (pump.fun) and treats HyperEVM as
# "not deployed yet". See README.md ("Run it", "Deploy the HyperEVM contract to mainnet", "Configuration").

PORT=8787
# Where the SQLite database, uploaded images and published coin metadata live
DATA_DIR=./data

# Public https origin of THIS site. Coin metadata links are built from it and are PERMANENT on-chain, and pump.fun
# (and other sites) fetch them, so it must be a real public address before you launch on Solana.
# PUBLIC_URL=https://your-domain.example

# ---- Solana (pump.fun, mainnet-beta) -------------------------------------------------------------------------
# Use a dedicated RPC for the server's indexers. This URL is never sent to browsers (they use /api/solana-rpc).
# SOL_RPC_URL=https://your-private-solana-rpc.example/?api-key=...

# ---- HyperEVM -------------------------------------------------------------------------------------------------
# Set after you deploy the Launchpad contract (see README). Until then HyperEVM shows as "not deployed yet".
# HYP_LAUNCHPAD=0xYourV4Launchpad   (the V4Launchpad address from deployments/<chainId>-v4.json)
# HYP_START_BLOCK=0
# 999 = mainnet (default), 998 = testnet
# HYP_CHAIN_ID=999
# HYP_RPC_URL=https://rpc.hyperliquid.xyz/evm
# Sent to visitors' browsers and wallets: keep any key-bearing URL out of this one.
# HYP_BROWSER_RPC_URL=https://rpc.hyperliquid.xyz/evm
# To run the EVM side on Elysium (chain 99901) instead of HyperEVM:
# HYP_CHAIN_ID=99901
# HYP_CHAIN_NAME=Elysium
# HYP_RPC_URL=https://heliosliq.app/rpc
# HYP_BROWSER_RPC_URL=https://heliosliq.app/rpc
# HYP_EXPLORER=https://...   (set this once you know Elysium's block explorer)
# USD prices come from CoinGecko (SOL, and Hyperliquid's HYPE). That is right for a chain whose HYPE is a bridged,
# 1:1 redeemable HYPE. If it is not, pin the EVM quote token's USD price yourself instead:
# EVM_QUOTE_USD=0.50

# Extra hosts allowed for coin metadata (IPFS gateways are built in), comma-separated
# METADATA_HOSTS=

# ---- Landing screen ---------------------------------------------------------------------------------------------
# The project's own token: its Solana mint (the pump.fun contract address). Shown on the landing screen with a Copy
# button and a link to https://pump.fun/coin/<address>. Leave unset and the landing screen shows "Coming soon".
# TOKEN_CA=YourTokenMintAddress
# Official X account (must be an https://x.com/... link). Default: https://x.com/elyonpad
# X_URL=https://x.com/elyonpad
